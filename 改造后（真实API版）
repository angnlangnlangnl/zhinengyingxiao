            <div class="form-group"><label class="form-label">登录账号</label><input type="text" class="form-input" id="subAccountUsername" placeholder="请输入登录账号"></div>
            <div class="form-group"><label class="form-label">登录密码</label><input type="password" class="form-input" id="subAccountPassword" placeholder="请输入登录密码"></div>
            <div class="form-group"><label class="form-label">初始余额</label><input type="number" class="form-input" id="subAccountBalance" placeholder="请输入初始余额" value="0"></div>
            <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:20px;"><button class="btn btn-outline" onclick="closeModal('subAccountModal')">取消</button><button class="btn btn-primary" onclick="confirmAddSubAccount()">✅ 确认添加</button></div>
        </div>
    </div>

    <script>
        // ============ API配置 ============
        const API_CONFIG = {
            baseUrl: 'http://localhost:5000/api',  // 后端API地址
            wsUrl: 'ws://localhost:5000/ws',       // WebSocket地址
            timeout: 10000
        };

        // ============ API客户端 ============
        class ApiClient {
            constructor() {
                this.token = localStorage.getItem('auth_token') || '';
                this.baseUrl = API_CONFIG.baseUrl;
            }

            async request(endpoint, options = {}) {
                const headers = {
                    'Content-Type': 'application/json',
                    ...(this.token && { 'Authorization': `Bearer ${this.token}` })
                };

                try {
                    const controller = new AbortController();
                    const timeoutId = setTimeout(() => controller.abort(), API_CONFIG.timeout);

                    const response = await fetch(`${this.baseUrl}${endpoint}`, {
                        ...options,
                        headers: { ...headers, ...options.headers },
                        signal: controller.signal
                    });

                    clearTimeout(timeoutId);

                    if (response.status === 401) {
                        localStorage.removeItem('auth_token');
                        this.token = '';
                        showLoginPage();
                        throw new Error('登录已过期，请重新登录');
                    }

                    const data = await response.json();
                    return data;
                } catch (error) {
                    if (error.name === 'AbortError') {
                        throw new Error('请求超时');
                    }
                    throw error;
                }
            }

            // 认证
            async login(username, password) {
                const response = await this.request('/auth/login', {
                    method: 'POST',
                    body: JSON.stringify({ username, password })
                });
                if (response.success && response.token) {
                    this.token = response.token;
                    localStorage.setItem('auth_token', response.token);
                }
                return response;
            }

            // 平台管理
            async getBoundPlatforms() {
                return this.request('/platforms/list');
            }

            async bindPlatform(data) {
                return this.request('/platforms/bind', {
                    method: 'POST',
                    body: JSON.stringify(data)
                });
            }

            async unbindPlatform(platformId) {
                return this.request(`/platforms/${platformId}/unbind`, {
                    method: 'DELETE'
                });
            }

            // 视频发现
            async discoverVideos(params) {
                return this.request('/discovery/videos', {
                    method: 'POST',
                    body: JSON.stringify(params)
                });
            }

            // 用户管理
            async getCollectedUsers() {
                return this.request('/users/collected');
            }

            // 代理商
            async getAgents() {
                return this.request('/agents/list');
            }

            async createAgent(data) {
                return this.request('/agents/create', {
                    method: 'POST',
                    body: JSON.stringify(data)
                });
            }

            // 子账户
            async getSubAccounts() {
                return this.request('/subaccounts/list');
            }

            async createSubAccount(data) {
                return this.request('/subaccounts/create', {
                    method: 'POST',
                    body: JSON.stringify(data)
                });
            }

            // 钱包
            async getWalletInfo() {
                return this.request('/wallet/info');
            }

            async rechargeWallet(amount) {
                return this.request('/wallet/recharge', {
                    method: 'POST',
                    body: JSON.stringify({ amount })
                });
            }

            async withdrawWallet(amount) {
                return this.request('/wallet/withdraw', {
                    method: 'POST',
                    body: JSON.stringify({ amount })
                });
            }

            // 系统
            async getStats() {
                return this.request('/stats/overview');
            }

            async startSystem(config) {
                return this.request('/system/start', {
                    method: 'POST',
                    body: JSON.stringify(config)
                });
            }

            async getLogs() {
                return this.request('/logs/list');
            }

            // WebSocket
            connectWebSocket(onMessage) {
                this.ws = new WebSocket(API_CONFIG.wsUrl);
                this.ws.onmessage = (event) => {
                    const data = JSON.parse(event.data);
                    onMessage(data);
                };
                this.ws.onclose = () => {
                    setTimeout(() => this.connectWebSocket(onMessage), 3000);
                };
            }
        }

        // ============ 系统状态 ============
        const api = new ApiClient();
        let systemState = {
            currentPage: 'dashboard',
            selectedPlatform: null,
            boundPlatforms: {},
            discoveredVideos: [],
            collectedUsers: [],
            tasks: [],
            templates: [],
            agents: [],
            subAccounts: [],
            walletBalance: 10000,
            totalRecharge: 50000,
            totalWithdraw: 10000,
            totalSpend: 30000,
            transactions: [],
            stats: { totalVideos: 0, totalUsers: 0, totalReplies: 0, totalFollows: 0, successRate: 0 },
            logs: []
        };

        const platformInfo = {
            douyin: { name: '抖音', icon: '🎵' },
            kuaishou: { name: '快手', icon: '📱' },
            bilibili: { name: 'B站', icon: '📺' },
            xiaohongshu: { name: '小红书', icon: '📕' },
            shipinhao: { name: '视频号', icon: '📺' }
        };

        // ============ 登录 ============
        async function handleLogin() {
            const username = document.getElementById('loginUsername').value.trim();
            const password = document.getElementById('loginPassword').value.trim();
            const loginBtn = document.getElementById('loginBtn');

            if (!username || !password) {
                alert('请输入用户名和密码');
                return;
            }

            loginBtn.innerHTML = '<span class="loading-spinner"></span> 登录中...';
            loginBtn.disabled = true;

            try {
                const response = await api.login(username, password);
                if (response.success) {
                    showMainApp(response.user);
                    addLog('success', '✅ 登录成功，欢迎回来！');
                } else {
                    alert(response.message || '用户名或密码错误');
                }
            } catch (error) {
                alert('登录失败：' + error.message);
            } finally {
                loginBtn.innerHTML = '登 录';
                loginBtn.disabled = false;
            }
        }

        function showMainApp(user) {
            document.getElementById('loginPage').style.display = 'none';
            document.getElementById('appContainer').classList.add('show');
            
            if (user) {
                document.getElementById('sidebarAvatar').textContent = user.username?.[0]?.toUpperCase() || 'A';
                document.getElementById('sidebarUsername').textContent = user.username || '管理员';
                document.getElementById('sidebarRole').textContent = user.role || '超级管理员';
            }
            
            initSystem();
            loadInitialData();
        }

        function showLoginPage() {
            document.getElementById('appContainer').classList.remove('show');
            document.getElementById('loginPage').style.display = 'flex';
        }

        function handleLogout() {
            if (confirm('确认退出登录？')) {
                api.token = '';
                localStorage.removeItem('auth_token');
                showLoginPage();
            }
        }

        // ============ 初始化数据加载 ============
        async function loadInitialData() {
            try {
                // 加载统计数据
                const statsData = await api.getStats();
                if (statsData.success) {
                    systemState.stats = statsData.stats;
                    updateAllStats();
                }

                // 加载已绑定平台
                const platformsData = await api.getBoundPlatforms();
                if (platformsData.success) {
                    systemState.boundPlatforms = platformsData.platforms;
                    updateBoundPlatformsTable();
                }

                // 加载代理商
                const agentsData = await api.getAgents();
                if (agentsData.success) {
                    systemState.agents = agentsData.agents;
                    updateAgentsTable();
                }

                // 加载子账户
                const subAccountsData = await api.getSubAccounts();
                if (subAccountsData.success) {
                    systemState.subAccounts = subAccountsData.subAccounts;
                    updateSubAccountsTable();
                }

                // 加载钱包
                const walletData = await api.getWalletInfo();
                if (walletData.success) {
                    systemState.walletBalance = walletData.balance;
                    systemState.transactions = walletData.transactions;
                    updateWalletDisplay();
                }
            } catch (error) {
                console.error('加载数据失败:', error);
                addLog('error', '加载数据失败：' + error.message);
            }
        }

        // ============ 页面切换 ============
        function switchPage(pageName) {
            systemState.currentPage = pageName;
            document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));
            const navItem = document.querySelector(`.nav-item[data-page="${pageName}"]`);
            if (navItem) navItem.classList.add('active');
            document.querySelectorAll('.page').forEach(page => page.classList.remove('active'));
            const pageElement = document.getElementById(`page-${pageName}`);
            if (pageElement) pageElement.classList.add('active');
        }

        // ============ 平台管理 ============
        function selectPlatform(platformKey) {
            systemState.selectedPlatform = platformKey;
            const info = platformInfo[platformKey];
            document.getElementById('modalTitle').textContent = `${info.icon} ${info.name} 平台绑定`;
            document.getElementById('modalPlatformSelect').value = platformKey;
            document.getElementById('modalAccountName').value = '';
            document.getElementById('modalAccountId').value = '';
            document.getElementById('modalApiKey').value = '';
            openModal('bindingModal');
        }

        function showBindingPanel() {
            systemState.selectedPlatform = null;
            document.getElementById('modalTitle').textContent = '绑定新平台';
            document.getElementById('modalPlatformSelect').value = '';
            document.getElementById('modalAccountName').value = '';
            document.getElementById('modalAccountId').value = '';
            document.getElementById('modalApiKey').value = '';
            openModal('bindingModal');
        }

        async function confirmBinding() {
            const platformKey = document.getElementById('modalPlatformSelect').value || systemState.selectedPlatform;
            const accountName = document.getElementById('modalAccountName').value.trim();
            const accountId = document.getElementById('modalAccountId').value.trim();
            const apiKey = document.getElementById('modalApiKey').value.trim();

            if (!platformKey) { alert('请选择平台'); return; }
            if (!accountName || !accountId) { alert('请填写账号名称和账号ID'); return; }

            try {
                const response = await api.bindPlatform({
                    platform: platformKey,
                    account_name: accountName,
                    account_id: accountId,
                    api_key: apiKey
                });

                if (response.success) {
                    addLog('success', `✅ ${platformInfo[platformKey].name} 平台绑定成功`);
                    closeModal('bindingModal');
                    loadInitialData();
                } else {
                    alert(response.message || '绑定失败');
                }
            } catch (error) {
                alert('绑定失败：' + error.message);
            }
        }

        function updateBoundPlatformsTable() {
            const tbody = document.getElementById('boundPlatformsBody');
            const platforms = Object.entries(systemState.boundPlatforms);

            if (platforms.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--text-secondary);">暂无绑定平台</td></tr>';
                document.getElementById('boundCount').textContent = '0 个平台';
                document.getElementById('platformBadge').textContent = '0';
                return;
            }

            tbody.innerHTML = platforms.map(([key, p]) => `
                <tr>
                    <td>${p.icon || platformInfo[key]?.icon || '📱'} ${p.name || platformInfo[key]?.name || key}</td>
                    <td>${p.account_name || p.accountName || '-'}</td>
                    <td>${p.account_id || p.accountId || '-'}</td>
                    <td><span style="color:var(--success);">● 已连接</span></td>
                    <td>${p.bound_at || p.boundAt || new Date().toLocaleString('zh-CN')}</td>
                    <td><button class="btn btn-outline" style="padding:5px 10px;font-size:12px;" onclick="unbindPlatform('${key}')">解绑</button></td>
                </tr>
            `).join('');

            document.getElementById('boundCount').textContent = `${platforms.length} 个平台`;
            document.getElementById('platformBadge').textContent = platforms.length;
        }

        async function unbindPlatform(platformKey) {
            if (!confirm('确认解绑该平台？')) return;
            try {
                const response = await api.unbindPlatform(platformKey);
                if (response.success) {
                    addLog('warning', `已解绑平台`);
                    loadInitialData();
                }
            } catch (error) {
                alert('解绑失败：' + error.message);
            }
        }

        // ============ 视频发现 ============
        async function startDiscovery() {
            const params = {
                industry: document.getElementById('discoveryIndustry').value,
                min_engagement: document.getElementById('discoveryEngagement').value,
                min_followers: document.getElementById('discoveryFollowers').value
            };

            addLog('info', `开始发现${params.industry}行业的优质视频...`);

            try {
                const response = await api.discoverVideos(params);
                if (response.success) {
                    systemState.discoveredVideos = response.videos;
                    systemState.stats.totalVideos += response.videos.length;
                    displayDiscoveredVideos(response.videos);
                    updateAllStats();
                    addLog('success', `✅ 发现 ${response.videos.length} 个优质视频`);
                }
            } catch (error) {
                addLog('error', '发现失败：' + error.message);
            }
        }

        function displayDiscoveredVideos(videos) {
            const container = document.getElementById('discoveredVideosList');
            container.innerHTML = videos.map(v => `
                <div style="background:var(--bg-dark);border:1px solid var(--border);border-radius:12px;padding:15px;">
                    <div style="font-weight:600;margin-bottom:10px;">${v.title}</div>
                    <div style="font-size:12px;color:var(--text-secondary);margin-bottom:10px;">👤 ${v.author} | 👍 ${v.likes} | 💬 ${v.comments}</div>
                    <span style="padding:3px 8px;background:rgba(16,185,129,0.2);color:#10b981;border-radius:10px;font-size:11px;">优质 ${v.score}分</span>
                </div>
            `).join('');
            document.getElementById('discoveredCount').textContent = `${videos.length} 个视频`;
        }

        // ============ 代理商 ============
        function addAgent() {
            document.getElementById('agentName').value = '';
            document.getElementById('agentUsername').value = '';
            document.getElementById('agentPassword').value = '';
            document.getElementById('agentBalance').value = '0';
            openModal('agentModal');
        }

        async function confirmAddAgent() {
            const data = {
                name: document.getElementById('agentName').value.trim(),
                username: document.getElementById('agentUsername').value.trim(),
                password: document.getElementById('agentPassword').value.trim(),
                balance: parseFloat(document.getElementById('agentBalance').value) || 0
            };

            if (!data.name || !data.username || !data.password) { alert('请填写完整信息'); return; }

            try {
                const response = await api.createAgent(data);
                if (response.success) {
                    addLog('success', `✅ 新增代理商：${data.name}`);
                    closeModal('agentModal');
                    loadInitialData();
                }
            } catch (error) {
                alert('添加失败：' + error.message);
            }
        }

        function updateAgentsTable() {
            const tbody = document.getElementById('agentsTableBody');
            if (systemState.agents.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:var(--text-secondary);">暂无代理商</td></tr>';
                document.getElementById('agentCount').textContent = '0 个代理商';
                return;
            }
            tbody.innerHTML = systemState.agents.map((a, i) => `
                <tr>
                    <td>${a.name}</td>
                    <td>${a.username}</td>
                    <td style="color:var(--primary-light);font-weight:600;">¥ ${(a.balance || 0).toFixed(2)}</td>
                    <td>${a.sub_account_count || a.subAccountCount || 0}</td>
                    <td><span style="color:var(--success);">● ${a.status || '正常'}</span></td>
                    <td>${a.created_at || a.createdAt || '-'}</td>
                    <td><button class="btn btn-danger" style="padding:5px 10px;font-size:12px;" onclick="deleteAgent(${i})">删除</button></td>
                </tr>
            `).join('');
            document.getElementById('agentCount').textContent = `${systemState.agents.length} 个代理商`;
            updateSubAccountAgentSelect();
        }

        function deleteAgent(index) {
            if (confirm('确认删除？')) {
                systemState.agents.splice(index, 1);
                updateAgentsTable();
            }
        }

        // ============ 子账户 ============
        function addSubAccount() {
            document.getElementById('subAccountName').value = '';
            document.getElementById('subAccountUsername').value = '';
            document.getElementById('subAccountPassword').value = '';
            document.getElementById('subAccountBalance').value = '0';
            updateSubAccountAgentSelect();
            openModal('subAccountModal');
        }

        function updateSubAccountAgentSelect() {
            const select = document.getElementById('subAccountAgent');
            select.innerHTML = '<option value="">请选择代理商</option>' + 
                systemState.agents.map((a, i) => `<option value="${i}">${a.name}</option>`).join('');
        }

        async function confirmAddSubAccount() {
            const data = {
                name: document.getElementById('subAccountName').value.trim(),
                agent_index: parseInt(document.getElementById('subAccountAgent').value),
                username: document.getElementById('subAccountUsername').value.trim(),
                password: document.getElementById('subAccountPassword').value.trim(),
                balance: parseFloat(document.getElementById('subAccountBalance').value) || 0
            };

            if (!data.name || !data.username || !data.password) { alert('请填写完整信息'); return; }
            if (isNaN(data.agent_index)) { alert('请选择所属代理商'); return; }

            try {
                const response = await api.createSubAccount(data);
                if (response.success) {
                    addLog('success', `✅ 新增子账户：${data.name}`);
                    closeModal('subAccountModal');
                    loadInitialData();
                }
            } catch (error) {
                alert('添加失败：' + error.message);
            }
        }

        function updateSubAccountsTable() {
            const tbody = document.getElementById('subAccountsTableBody');
            if (systemState.subAccounts.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--text-secondary);">暂无子账户</td></tr>';
                document.getElementById('subAccountCount').textContent = '0 个子账户';
                return;
            }
            tbody.innerHTML = systemState.subAccounts.map((sa, i) => `
                <tr>
                    <td>${sa.name}</td>
                    <td>${sa.agent_name || sa.agentName || '-'}</td>
                    <td style="color:var(--primary-light);font-weight:600;">¥ ${(sa.balance || 0).toFixed(2)}</td>
                    <td><span style="color:var(--success);">● ${sa.status || '正常'}</span></td>
                    <td>${sa.created_at || sa.createdAt || '-'}</td>
                    <td><button class="btn btn-danger" style="padding:5px 10px;font-size:12px;" onclick="deleteSubAccount(${i})">删除</button></td>
                </tr>
            `).join('');
            document.getElementById('subAccountCount').textContent = `${systemState.subAccounts.length} 个子账户`;
        }

        function deleteSubAccount(index) {
            if (confirm('确认删除？')) {
                systemState.subAccounts.splice(index, 1);
                updateSubAccountsTable();
            }
        }

        // ============ 钱包 ============
        async function rechargeWallet() {
            const amount = prompt('请输入充值金额：', '1000');
            if (amount && !isNaN(amount) && parseFloat(amount) > 0) {
                try {
                    const response = await api.rechargeWallet(parseFloat(amount));
                    if (response.success) {
                        systemState.walletBalance = response.balance;
                        updateWalletDisplay();
                        addLog('success', `✅ 充值成功：¥${amount}`);
                    }
                } catch (error) {
                    alert('充值失败：' + error.message);
                }
            }
        }

        async function withdrawWallet() {
            const amount = prompt('请输入提现金额：', '500');
            if (amount && !isNaN(amount) && parseFloat(amount) > 0) {
                try {
                    const response = await api.withdrawWallet(parseFloat(amount));
                    if (response.success) {
                        systemState.walletBalance = response.balance;
                        updateWalletDisplay();
                        addLog('warning', `💸 提现成功：¥${amount}`);
                    } else {
                        alert(response.message || '提现失败');
                    }
                } catch (error) {
                    alert('提现失败：' + error.message);
                }
            }
        }

        function updateWalletDisplay() {
            document.getElementById('walletBalance').textContent = `¥ ${systemState.walletBalance.toFixed(2)}`;
            document.getElementById('totalRecharge').textContent = `¥ ${systemState.totalRecharge.toFixed(2)}`;
            document.getElementById('totalWithdraw').textContent = `¥ ${systemState.totalWithdraw.toFixed(2)}`;
            document.getElementById('totalSpend').textContent = `¥ ${systemState.totalSpend.toFixed(2)}`;

            const tbody = document.getElementById('walletTransactionsBody');
            if (systemState.transactions.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--text-secondary);">暂无交易记录</td></tr>';
                return;
            }
            tbody.innerHTML = systemState.transactions.map(t => `
                <tr>
                    <td>${t.id}</td>
                    <td><span style="color:${t.type === '充值' ? 'var(--success)' : 'var(--warning)'};">${t.type}</span></td>
                    <td style="color:${t.type === '充值' ? 'var(--success)' : 'var(--warning)'};">${t.amount}</td>
                    <td>${t.balance}</td>
                    <td>${t.time}</td>
                    <td>${t.note}</td>
                </tr>
            `).join('');
        }

        // ============ 系统运行 ============
        async function startSystem() {
            const config = {
                auto_follow: document.getElementById('autoFollow')?.checked ?? true,
                auto_reply: document.getElementById('autoReply')?.checked ?? true,
                operation_interval: document.getElementById('operationInterval')?.value ?? 5,
                max_operations: document.getElementById('maxOperations')?.value ?? 100
            };

            addLog('success', '🚀 系统开始运行');
            document.getElementById('systemStatus').textContent = '运行中';

            try {
                const response = await api.startSystem(config);
                if (response.success) {
                    addLog('info', '系统已启动，正在执行自动化任务...');
                }
            } catch (error) {
                addLog('error', '启动失败：' + error.message);
                document.getElementById('systemStatus').textContent = '系统就绪';
            }
        }

        // ============ 用户管理 ============
        async function exportUsers() {
            try {
                const response = await api.getCollectedUsers();
                if (response.success && response.users.length > 0) {
                    systemState.collectedUsers = response.users;
                    updateUsersTable();
                }
                addLog('success', '✅ 用户数据导出成功');
            } catch (error) {
                addLog('error', '导出失败：' + error.message);
            }
        }

        function updateUsersTable() {
            const tbody = document.getElementById('usersTableBody');
            if (systemState.collectedUsers.length === 0) {
                tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;color:var(--text-secondary);">暂无用户数据</td></tr>';
                document.getElementById('usersCount').textContent = '0 个用户';
                return;
            }
            tbody.innerHTML = systemState.collectedUsers.map((u, i) => `
                <tr>
                    <td>${u.nickname || u.name}</td>
                    <td>${u.platform}</td>
                    <td>${u.followers_count || u.followers}</td>
                    <td>${u.engagement_rate || u.engagement}</td>
                    <td>${u.location || '-'}</td>
                    <td>${(u.tags || []).map(t => `<span style="padding:2px 8px;background:rgba(37,99,235,0.2);color:#60a5fa;border-radius:10px;font-size:11px;">${t}</span>`).join(' ')}</td>
                    <td><span style="color:var(--success);">● ${u.status || '已采集'}</span></td>
                    <td><button class="btn btn-outline" style="padding:5px 10px;font-size:12px;" onclick="deleteUser(${i})">删除</button></td>
                </tr>
            `).join('');
            document.getElementById('usersCount').textContent = `${systemState.collectedUsers.length} 个用户`;
        }

        function deleteUser(index) {
            systemState.collectedUsers.splice(index, 1);
            updateUsersTable();
            addLog('warning', '已删除用户');
        }

        // ============ 定时任务 ============
        function addTask() {
            const task = {
                name: `自动互动任务${systemState.tasks.length + 1}`,
                time: '每天 09:00',
                platform: '抖音',
                status: '待执行',
                lastRun: '-'
            };
            systemState.tasks.push(task);
            updateTasksTable();
            addLog('success', `✅ 创建定时任务：${task.name}`);
        }

        function updateTasksTable() {
            const tbody = document.getElementById('tasksTableBody');
            if (systemState.tasks.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--text-secondary);">暂无定时任务</td></tr>';
                document.getElementById('taskCount').textContent = '0 个任务';
                return;
            }
            tbody.innerHTML = systemState.tasks.map((t, i) => `
                <tr>
                    <td>${t.name}</td><td>${t.time}</td><td>${t.platform}</td>
                    <td><span style="color:var(--warning);">● ${t.status}</span></td><td>${t.lastRun}</td>
                    <td><button class="btn btn-outline" style="padding:5px 10px;font-size:12px;" onclick="deleteTask(${i})">删除</button></td>
                </tr>
            `).join('');
            document.getElementById('taskCount').textContent = `${systemState.tasks.length} 个任务`;
        }

        function deleteTask(index) {
            systemState.tasks.splice(index, 1);
            updateTasksTable();
            addLog('warning', '已删除定时任务');
        }

        // ============ 回复模板 ============
        function addTemplate() {
            const templates = [
                '感谢关注！期待更多精彩内容分享～',
                '谢谢支持！会继续努力创作优质内容',
                '欢迎关注！一起交流学习',
                '感谢认可！有什么想了解的可以留言',
                '很实用的内容！已经点赞关注了'
            ];
            const template = {
                name: `回复模板${systemState.templates.length + 1}`,
                content: templates[systemState.templates.length % templates.length]
            };
            systemState.templates.push(template);
            updateTemplatesList();
            addLog('success', `✅ 创建回复模板：${template.name}`);
        }

        function updateTemplatesList() {
            const container = document.getElementById('templatesList');
            if (systemState.templates.length === 0) {
                container.innerHTML = '<div style="text-align:center;color:var(--text-secondary);padding:40px;">暂无回复模板</div>';
                document.getElementById('templateCount').textContent = '0 个模板';
                return;
            }
            container.innerHTML = systemState.templates.map((t, i) => `
                <div style="background:var(--bg-dark);border:1px solid var(--border);border-radius:12px;padding:15px;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;">
                    <div><div style="font-weight:600;margin-bottom:5px;">${t.name}</div><div style="font-size:13px;color:var(--text-secondary);">${t.content}</div></div>
                    <button class="btn btn-outline" style="padding:5px 10px;font-size:12px;" onclick="deleteTemplate(${i})">删除</button>
                </div>
            `).join('');
            document.getElementById('templateCount').textContent = `${systemState.templates.length} 个模板`;
        }

        function deleteTemplate(index) {
            systemState.templates.splice(index, 1);
            updateTemplatesList();
            addLog('warning', '已删除回复模板');
        }

        // ============ 智能分析 ============
        function runAnalysis() {
            addLog('info', '运行AI用户行为分析...');
            setTimeout(() => {
                addLog('success', '✅ AI分析完成，生成用户画像报告');
                addLog('info', '📊 分析结果：活跃用户占比65%，潜在客户占比25%');
            }, 2000);
        }

        // ============ 更新统计 ============
        function updateAllStats() {
            const boundCount = Object.keys(systemState.boundPlatforms).length;
            setText('dashBoundPlatforms', `${boundCount}/5`);
            setText('dashVideos', systemState.stats.totalVideos);
            setText('dashUsers', systemState.stats.totalUsers);
            setText('dashReplies', systemState.stats.totalReplies);
            setText('dashFollows', systemState.stats.totalFollows);
            setText('dashSuccessRate', `${systemState.stats.successRate}%`);
            setText('reportVideos', systemState.stats.totalVideos);
            setText('reportUsers', systemState.stats.totalUsers);
            setText('reportReplies', systemState.stats.totalReplies);
            setText('reportSuccess', `${systemState.stats.successRate}%`);
            setText('platformBadge', boundCount);
        }

        function setText(id, value) {
            const el = document.getElementById(id);
            if (el) el.textContent = value;
        }

        // ============ 弹窗 ============
        function openModal(modalId) { document.getElementById(modalId).classList.add('show'); }
        function closeModal(modalId) { document.getElementById(modalId).classList.remove('show'); }

        // ============ 日志 ============
        function addLog(type, message) {
            const time = new Date().toLocaleTimeString('zh-CN', { hour12: false });
            const logEntry = { time, type, message };
            systemState.logs.push(logEntry);
            appendLogToContainer('mainLogContainer', logEntry);
            appendLogToContainer('dashLogs', logEntry);
        }

        function appendLogToContainer(containerId, logEntry) {
            const container = document.getElementById(containerId);
            if (!container) return;
            const div = document.createElement('div');
            div.className = 'log-entry';
            let typeClass = 'log-info';
            switch(logEntry.type) {
                case 'success': typeClass = 'log-success'; break;
                case 'warning': typeClass = 'log-warning'; break;
                case 'error': typeClass = 'log-error'; break;
            }
            div.innerHTML = `<span class="log-time">[${logEntry.time}]</span><span class="${typeClass}">${logEntry.message}</span>`;
            container.appendChild(div);
            container.scrollTop = container.scrollHeight;
        }

        function clearLogs() {
            systemState.logs = [];
            const mainContainer = document.getElementById('mainLogContainer');
            const dashContainer = document.getElementById('dashLogs');
            if (mainContainer) mainContainer.innerHTML = '';
            if (dashContainer) dashContainer.innerHTML = '';
            addLog('info', '日志已清空');
        }

        function exportLogs() {
            const logText = systemState.logs.map(log => `[${log.time}] ${log.message}`).join('\n');
            const blob = new Blob([logText], { type: 'text/plain' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `操作日志_${new Date().toISOString().slice(0,10)}.txt`;
            a.click();
            URL.revokeObjectURL(url);
            addLog('success', '✅ 日志导出成功');
        }

        // ============ 初始化 ============
        function initSystem() {
            updateAllStats();
            updateBoundPlatformsTable();
            updateAgentsTable();
            updateSubAccountsTable();
            updateWalletDisplay();
            
            // 连接WebSocket
            api.connectWebSocket((data) => {
                if (data.type === 'log') {
                    addLog(data.level, data.message);
                } else if (data.type === 'stats_update') {
                    systemState.stats = data.stats;
                    updateAllStats();
                }
            });
        }

        // 初始日志
        addLog('info', '系统初始化完成，请登录');
    </script>
</body>
</html>
